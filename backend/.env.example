# Copy this file to backend/.env and edit values as needed.
# Anything not set here falls back to the default in app/config.py.

# --- Server ---
HOST=127.0.0.1
PORT=8000
# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# --- Model ---
# Folder containing OpenVoice V2's "checkpoints_v2" contents
# (converter/, base_speakers/). Download instructions: README "Model setup".
OPENVOICE_CHECKPOINT_DIR=./models/checkpoints_v2
# MeloTTS language/speaker to use as the base voice before conversion.
MELO_LANGUAGE=EN
MELO_SPEAKER=EN-Default
# "auto" picks cuda:0 if available, else cpu. Set explicitly to force one.
DEVICE=auto
# OpenVoice can embed an inaudible watermark in generated audio.
# Off by default for a personal app; the extra wavmark model load also
# costs a few seconds of startup time.
ENABLE_WATERMARK=false

# --- Text limits ---
MAX_CHARS_PER_CHUNK=350
MAX_TOTAL_CHARS=5000

# --- Uploads ---
MAX_UPLOAD_MB=25
MIN_REFERENCE_SECONDS=3
MAX_REFERENCE_SECONDS=180

# --- Fish Audio TTS ---
# Get your key at https://fish.audio — create a voice clone there to get FISH_VOICE_ID.
FISH_API_KEY=sk-fish-x9lamFLtH6ZZcRAu9SQloh4hAoKLc9FdHils85iBqY8
FISH_VOICE_ID=711cf3ed00ab441a8f54a45058047b7a
FISH_TTS_MODEL=s2.1-pro-free



